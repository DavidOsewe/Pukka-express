# Keep these values in your deployment provider's encrypted environment settings.
DHL_API_KEY=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
# Use "sandbox" to call apis-sandbox.fedex.com; omit or use "production" for live FedEx.
FEDEX_ENVIRONMENT=sandbox
# Valid values: client_credentials, csp_credentials, client_pc_credentials
FEDEX_GRANT_TYPE=client_credentials
# FedEx Track API request locale, e.g. en_US.
FEDEX_LOCALE=en_US
# Required only for csp_credentials or client_pc_credentials flows.
FEDEX_CHILD_KEY=
FEDEX_CHILD_SECRET=
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_COUNTRY_CODE=

# Shipment-creation email notifications (Resend)
RESEND_API_KEY=
# Must be a sender address on a domain verified in Resend, e.g. Pukka Express <updates@yourdomain.com>
EMAIL_FROM=
# Public site URL used in customer emails
PUBLIC_SITE_URL=https://pukka-express.vercel.app

# Supabase database and admin authentication
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# Server-only. Never put this value in browser JavaScript.
SUPABASE_SERVICE_ROLE_KEY=
